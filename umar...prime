
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Umar Prime</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f8f7f2;
      color: #222;
    }
    header {
      padding: 22px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 25px;
      font-weight: bold;
    }
    .logo {
      background: #20211f;
      color: white;
      padding: 14px;
      border-radius: 14px;
    }
    main {
      max-width: 460px;
      margin: 35px auto;
      padding: 28px;
      background: white;
      border: 1px solid #e9e6dd;
      border-radius: 25px;
    }
    h1 { margin-top: 0; }
    p { color: #777; line-height: 1.5; }
    input {
      width: 100%;
      padding: 14px;
      margin: 8px 0 18px;
      border: 1px solid #ddd;
      border-radius: 12px;
      font-size: 16px;
    }
    button {
      padding: 14px;
      border: 0;
      border-radius: 12px;
      cursor: pointer;
      font-weight: bold;
    }
    .tabs { display: flex; gap: 8px; margin-bottom: 25px; }
    .tabs button { flex: 1; background: #f0efe9; }
    .tabs .active, .submit {
      background: #20211f;
      color: white;
    }
    .submit { width: 100%; }
    .hidden { display: none; }
    .message {
      padding: 12px;
      background: #fff1d9;
      border-radius: 10px;
      margin-bottom: 15px;
    }
    @media(max-width:520px) {
      main { margin: 20px 14px; padding: 22px; }
    }
  </style>
</head>
<body>
  <header>
    <div class="logo">UP</div>
    <span>Umar Prime</span>
  </header>

  <main>
    <div class="tabs">
      <button id="loginTab" class="active" onclick="setMode('login')">
        Login
      </button>
      <button id="signupTab" onclick="setMode('signup')">
        Sign Up
      </button>
    </div>

    <h1 id="heading">Welcome Back</h1>
    <p id="description">Login to your Umar Prime account.</p>

    <div id="message" class="message hidden"></div>

    <form id="authForm">
      <div id="nameField" class="hidden">
        <label for="name">Full Name</label>
        <input id="name" autocomplete="name" placeholder="Your name">
      </div>

      <label for="email">Email Address</label>
      <input id="email" type="email" required
        autocomplete="email" placeholder="you@example.com">

      <label for="password">Password</label>
      <input id="password" type="password" required
        minlength="10" autocomplete="current-password"
        placeholder="Enter password">

      <div id="confirmField" class="hidden">
        <label for="confirm">Confirm Password</label>
        <input id="confirm" type="password" minlength="10"
          placeholder="Enter password again">
      </div>

      <button class="submit" id="submitButton" type="submit">
        Login
      </button>
    </form>

    <p id="footnote">
      Secure server authentication is required for real accounts.
    </p>
  </main>

  <script>
    let mode = "login";

    function setMode(nextMode) {
      mode = nextMode;
      const signup = mode === "signup";

      document.getElementById("nameField").classList.toggle("hidden", !signup);
      document.getElementById("confirmField").classList.toggle("hidden", !signup);
      document.getElementById("name").required = signup;
      document.getElementById("confirm").required = signup;

      document.getElementById("loginTab").classList.toggle("active", !signup);
      document.getElementById("signupTab").classList.toggle("active", signup);
      document.getElementById("heading").textContent =
        signup ? "Create Account" : "Welcome Back";
      document.getElementById("description").textContent =
        signup ? "Join Umar Prime today." : "Login to your account.";
      document.getElementById("submitButton").textContent =
        signup ? "Create Account" : "Login";
      document.getElementById("message").classList.add("hidden");
    }

    document.getElementById("authForm").addEventListener("submit", async function(event) {
      event.preventDefault();

      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value;
      const message = document.getElementById("message");

      if (mode === "signup" &&
          password !== document.getElementById("confirm").value) {
        message.textContent = "Passwords do not match.";
        message.classList.remove("hidden");
        return;
      }

      // Real account authentication is handled by the Node.js backend.
      try {
        const response = await fetch(
          mode === "signup" ? "/api/register" : "/api/login",
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({
              name: document.getElementById("name").value.trim(),
              email: email,
              password: password
            })
          }
        );

        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Request failed.");

        document.querySelector("main").innerHTML =
          "<h1>Welcome, " +
          escapeText(result.user.name) +
          "</h1><p>You are logged in to Umar Prime.</p>" +
          '<button class="submit" onclick="logout()">Logout</button>';
      } catch (error) {
        message.textContent = error.message.includes("fetch")
          ? "Backend connect nahi hai. Node.js server start karein."
          : error.message;
        message.classList.remove("hidden");
      }
    });

    function escapeText(text) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    async function logout() {
      await fetch("/api/logout", {
        method: "POST",
        credentials: "same-origin"
      });
      location.reload();
    }
  </script>
</body>
</html>
